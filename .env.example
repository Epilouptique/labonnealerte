# Modèle de configuration. Copier en .env et remplir.
# VALEURS D'EXEMPLE UNIQUEMENT : ce fichier est versionné, n'y mettez jamais une
# valeur réelle. En production, les variables vivent dans Railway, pas ici.
#
# Tenu à jour le 10/09/2026 par comparaison avec les process.env.* réellement lus
# dans server/ et scripts/. Il accusait 23 variables de retard, dont IP_HASH_SALT :
# un clone neuf qui suivait ce fichier ne démarrait pas.
# Pour vérifier qu'il n'a pas redérivé :
#   grep -rhoE "process\.env\.[A-Z_][A-Z0-9_]*" server/ scripts/ --include=*.js | sort -u

# ═══ OBLIGATOIRE — sans elle, le serveur NE DÉMARRE PAS ════════════════════════
# Sel de hachage des IP de signalement (server/ugc.js). Son absence lève une
# exception À L'IMPORT de ugc.js, donc au démarrage : c'est voulu, un hachage
# silencieusement faible serait pire. Générer une valeur aléatoire avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=remplacer-par-64-caracteres-hexadecimaux-aleatoires

# ═══ Socle ═════════════════════════════════════════════════════════════════════
# Connexion PostgreSQL.
DATABASE_URL=postgresql://user:password@host:port/dbname

# Port du serveur Express. Railway fournit le sien en production.
PORT=3000

# URL publique de base (callbacks OAuth, liens des e-mails).
# En prod : https://labonnealerte.fr
BASE_URL=http://localhost:3000

# Fuseau du processus Node. Le dépôt raisonne en heure LOCALE (getHours, getDate…) :
# sans cette ligne, la machine de dev impose le sien. Même valeur que ENV TZ du
# Dockerfile, les deux doivent rester alignés. Lue par Node lui-même, et non par un
# process.env.TZ du code : c'est normal qu'aucun grep ne la trouve.
TZ=Europe/Paris

# ═══ E-mails et notifications ══════════════════════════════════════════════════
# Clé API Resend (envoi des e-mails).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Notifications push web (VAPID) — générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@example.org

# ═══ Connexion (OAuth) ═════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

GITHUB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# Twitch (sources Twitch). Optionnel : sans les deux, les sources concernées sont
# désactivées proprement (twitch-auth.js isConfigured()).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ═══ Soutien financier ═════════════════════════════════════════════════════════
# Boutons de don activés côté front UNIQUEMENT si définis. Doivent commencer par https://
# PayPal : lien PayPal.Me ou bouton Don (ex. https://paypal.me/NomDuCompte).
# Ko-fi : page Ko-fi (ex. https://ko-fi.com/NomDuCompte).
PAYPAL_DONATE_URL=
KOFI_URL=

# ═══ Clés d'API des sources ════════════════════════════════════════════════════
# Toutes optionnelles pour démarrer : une source dont la clé manque échoue ou se
# désactive, sans empêcher les autres de tourner.

# Météo-France — vigilance (header "apikey").
METEOFRANCE_API_KEY=eyJxxxxxxxxxxxxxxxxxxxx
# Météo-France — vigilance submersion (vigilance-submersion.js).
METEOFRANCE_VIGILANCE_API_KEY=
# Point d'accès de la vigilance. Optionnel : défaut = l'API publique DPVigilance.
METEOFRANCE_VIGILANCE_URL=
# Météo-France — vigilance outre-mer, URL complète du flux (cyclones-outremer.js).
METEOFRANCE_VIGILANCE_OM_URL=
# Météo-France — bulletins d'avalanche DPBRA (risque-avalanche.js).
METEOFRANCE_DPBRA_API_KEY=

# RTE — OAuth2 (source EcoWatt).
RTE_CLIENT_ID=00000000-0000-0000-0000-000000000000
RTE_CLIENT_SECRET=00000000-0000-0000-0000-000000000000

# France Travail — OAuth2. Le scope est optionnel (défaut dans francetravail-auth.js).
FRANCETRAVAIL_CLIENT_ID=
FRANCETRAVAIL_CLIENT_SECRET=
FRANCETRAVAIL_SCOPE=

# Légifrance (PISTE) — OAuth2. Le scope est optionnel (défaut dans legifrance-auth.js).
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
LEGIFRANCE_SCOPE=

# SNCF — perturbations (sncf-perturbations.js).
SNCF_API_KEY=

# URLhaus (abuse.ch) — sécurité de domaine (domaine-securite.js).
URLHAUS_AUTH_KEY=

# iplocate — géolocalisation IP pour le pré-remplissage du profil. Optionnel : sans
# clé, l'API est appelée en mode anonyme, avec un quota plus bas.
IPLOCATE_APIKEY=

# ═══ Service partenaire DoomName ═══════════════════════════════════════════════
# Clé partagée pour enregistrer les domaines suivis côté DoomName (doomname.js).
DOOMNAME_INTERNAL_KEY=
# Optionnel : défaut https://www.doomname.com
DOOMNAME_TRACK_URL=

# ═══ Infrastructure et réglages ════════════════════════════════════════════════
# Secret partagé avec le CDN. L'en-tête cf-connecting-ip n'est cru QUE si la requête
# porte x-origin-secret égal à cette valeur ; sinon repli sur X-Forwarded-For.
# Laisser vide en dev.
ORIGIN_SECRET=

# Mettre à 1 pour journaliser l'IP cliente résolue (diagnostic). Vide = désactivé.
LOG_CLIENT_IP=

# Plafond de combinaisons interrogées par source externe paramétrée. Défaut : 20.
EXTERNAL_MAX_COMBOS=

# ═══ Développement uniquement ══════════════════════════════════════════════════
# Chemin d'un Chromium local si Playwright ne trouve pas le sien. Inutile en prod :
# l'image Docker Playwright embarque ses navigateurs.
PLAYWRIGHT_CHROMIUM_PATH=

# Jeton de session utilisé par les scripts de capture (scripts/capture-*.js).
LBA_TOKEN=
