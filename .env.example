# Connexion PostgreSQL (Railway plus tard)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Clé API Resend (emails, plus tard)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Clé API Météo-France (source vigilance, header "apikey")
METEOFRANCE_API_KEY=eyJxxxxxxxxxxxxxxxxxxxx

# Identifiants OAuth2 RTE (source EcoWatt)
RTE_CLIENT_ID=00000000-0000-0000-0000-000000000000
RTE_CLIENT_SECRET=00000000-0000-0000-0000-000000000000

# URL publique de base (callbacks OAuth). En prod : https://www.labonnealerte.fr
BASE_URL=http://localhost:3000

# OAuth Google (connexion)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# OAuth GitHub (connexion)
GITHUB_CLIENT_ID=xxxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# Port du serveur Express
PORT=3000

# Notifications push web (VAPID) — générer avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@labonnealerte.fr
