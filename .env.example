# Connexion PostgreSQL (Railway plus tard)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Clé API Resend (emails, plus tard)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Clé API Météo-France (source vigilance, header "apikey")
METEOFRANCE_API_KEY=eyJxxxxxxxxxxxxxxxxxxxx

# Identifiants OAuth2 RTE (source EcoWatt)
RTE_CLIENT_ID=00000000-0000-0000-0000-000000000000
RTE_CLIENT_SECRET=00000000-0000-0000-0000-000000000000

# Port du serveur Express
PORT=3000
